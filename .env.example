# Copy this file to .env and replace every placeholder before starting Compose.
# The real .env file is ignored by Git. Never commit or share it.

# Public hostname configured as a Cloudflare Tunnel Published Application.
# Enter only the hostname, without https:// or a trailing slash.
DOMAIN=pos.example.com

# Token of a remotely managed Cloudflare Tunnel. Keep this value secret.
CLOUDFLARE_TUNNEL_TOKEN=replace_with_cloudflare_tunnel_token

# Use long, unique database passwords. The application and root passwords
# must be different.
MYSQL_DATABASE=replace_with_database_name
MYSQL_USER=replace_with_database_user
MYSQL_PASSWORD=replace_with_a_strong_application_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_strong_root_password
