APP_NAME=Hana POS API
API_PREFIX=/api
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=replace_with_database_name
MYSQL_USER=replace_with_database_user
MYSQL_PASSWORD=replace_with_a_strong_password
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
CORS_ORIGIN_REGEX=^http://(localhost|127\.0\.0\.1|192\.168\.\d{1,3}\.\d{1,3}):5173$
